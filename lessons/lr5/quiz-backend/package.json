    "prisma": "^6.19.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.19.37",
    "@vitest/coverage-v8": "^4.1.2",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2",
    "vitest-mock-extended": "^3.1.1"
  }
}
