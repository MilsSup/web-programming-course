{
  "name": "quiz-backend",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test:unit": "vitest run unit", 
    "test:feature": "vitest run feature",
